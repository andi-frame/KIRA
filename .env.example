DATABASE_URL=postgresql+asyncpg://kira:kira@localhost:5455/kira
TEST_DATABASE_URL=postgresql+asyncpg://kira:kira@localhost:5455/kira_test
JWT_SECRET=ganti-dengan-string-acak-minimal-32-karakter

# Model bahasa. Pilih SATU jalur:
# 1) Anthropic langsung (biarkan LLM_BASE_URL kosong):
ANTHROPIC_API_KEY=
LLM_MODEL_CHAT=claude-sonnet-5-5
LLM_MODEL_EXTRACT=claude-haiku-5-5
# 2) Penyedia kompatibel OpenAI, mis. gerbang 9router (isi LLM_BASE_URL dan kunci; nama model mengikuti penyedia):
# LLM_BASE_URL=https://9router.byhan.id/v1
# LLM_API_KEY=            # atau 9ROUTER_API_KEY=
# LLM_MODEL_CHAT=ag/gemini-3.8-flash-high
# LLM_MODEL_EXTRACT=ag/gemini-3.8-flash-high
LLM_BASE_URL=
LLM_API_KEY=

STT_BASE_URL=https://api.groq.com/openai/v1
STT_API_KEY=
STT_MODEL=whisper-large-v3-turbo
DEMO_CACHE=false
CORS_ORIGINS=*
