# Salin ke .env.production lalu isi. JANGAN di-commit (sudah di .gitignore).
KIRA_DOMAIN=api.contoh-kira.id
POSTGRES_PASSWORD=ganti-dengan-kata-sandi-acak-panjang
# openssl rand -hex 32
JWT_SECRET=
# Origin web aplikasi, pisahkan dengan koma. Jangan '*' di produksi.
CORS_ORIGINS=https://app.contoh-kira.id

# Model bahasa: isi SATU jalur (lihat .env.example).
ANTHROPIC_API_KEY=
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL_CHAT=claude-sonnet-5-5
LLM_MODEL_EXTRACT=claude-haiku-5-5

STT_API_KEY=
# Opsional: Google Places untuk "Tempat cek terdekat". Kosong = OpenStreetMap (tanpa kunci).
GOOGLE_PLACES_API_KEY=
# Hanya bila memakai jembatan WhatsApp (prototype).
BOT_SECRET=
